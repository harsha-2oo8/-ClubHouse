# =============================================================================
# ClubHouse — environment configuration template
# Copy to .env (dev) / set in hosting provider (prod). NEVER commit real values.
# Labels: REQUIRED | OPTIONAL | TEMPORARY BOOTSTRAP | SERVER ONLY | FRONTEND SAFE
# =============================================================================

# --- SERVER ONLY — REQUIRED ---------------------------------------------------
# Supabase Session pooler URI (port 5432). The direct db.* host is IPv6-only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Clerk publishable key for the API (REQUIRED). Production MUST be pk_live_…
CLERK_PUBLISHABLE_KEY=pk_live_xxx

# Clerk secret key for the API (REQUIRED, SERVER ONLY — never VITE_).
# Production MUST be sk_live_…. Enables token verification + /api/__clerk proxy.
CLERK_SECRET_KEY=sk_live_xxx

# API port (REQUIRED by the server entrypoint; Render supplies PORT itself)
PORT=8080

# --- SERVER ONLY — CORS -------------------------------------------------------
# REQUIRED in production: comma-separated exact origins (no trailing slashes).
# Example: CORS_ORIGINS=https://clubhouse-xxx.vercel.app
# When unset, dev allows local origins; production reflects + logs a warning.
CORS_ORIGINS=

# --- TEMPORARY BOOTSTRAP (remove after first admin exists) --------------------
# A matching user gets role="admin" ONLY at first profile creation.
# Afterwards the DB role is the source of truth — leave these empty.
ADMIN_EMAILS=
ADMIN_CLERK_IDS=

# --- SERVER ONLY — GOOGLE CLOUD STORAGE (uploads on Render) -------------------
# REQUIRED for file uploads in production (avatars, logos, brochures, banners).
# Create a service account with Storage Object Admin on ONE bucket, then set:
GCS_PROJECT_ID=
GCS_BUCKET_NAME=clubhouse-uploads
GCS_CLIENT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com
# Paste the full PEM private key; literal \n sequences are converted automatically.
GCS_PRIVATE_KEY=

# Legacy Replit object-storage paths (OPTIONAL, only if still used).
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# --- SERVER ONLY — OPTIONAL TUNING --------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Rate limits (requests per window per user/IP). Defaults shown.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_SEARCH_MAX=60

# --- FRONTEND SAFE (VITE_ — embedded in the bundle, never secrets) ------------
# REQUIRED. Production MUST be pk_live_… (same instance as the API key above).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# REQUIRED for split deploys (Vercel → Render). No trailing slash.
# Example: VITE_API_URL=https://clubhouse-api-xxxx.onrender.com
VITE_API_URL=

# OPTIONAL canonical app URL (defaults to window.location.origin).
VITE_APP_URL=

# OPTIONAL Clerk proxy — only if the Clerk architecture requires it.
VITE_CLERK_PROXY_URL=
