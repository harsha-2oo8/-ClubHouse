# =============================================================================
# ClubHouse — environment configuration template
# Copy to .env (dev) / set in hosting provider (prod). NEVER commit real values.
# =============================================================================

# --- REQUIRED ---------------------------------------------------------------
# PostgreSQL connection string (REQUIRED everywhere the API or drizzle-kit runs)
DATABASE_URL=postgresql://user:password@localhost:5432/clubhouse

# Clerk publishable key for the API server (REQUIRED)
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Clerk publishable key for the Vite frontend (REQUIRED, must start with VITE_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- OPTIONAL ----------------------------------------------------------------
# Clerk secret key (PRODUCTION ONLY — enables the /api/__clerk proxy)
CLERK_SECRET_KEY=sk_test_xxx

# Custom Clerk proxy URL for the frontend (OPTIONAL, e.g. https://app.example.com/api/__clerk)
VITE_CLERK_PROXY_URL=

# Legacy session secret (OPTIONAL, documented in runbook; unused by Clerk flows)
SESSION_SECRET=change-me-in-production

# --- ADMIN BOOTSTRAP (first-boot only) ---------------------------------------
# Comma-separated allowlists. A matching user is granted role "admin" ONLY at
# first profile creation. Existing roles are controlled by the DB afterwards.
# Leave empty in normal operation.
ADMIN_EMAILS=
ADMIN_CLERK_IDS=

# --- OBJECT STORAGE (required only when file uploads are used) ---------------
PUBLIC_OBJECT_SEARCH_PATHS=/public-bucket/assets
PRIVATE_OBJECT_DIR=/private-bucket/clubhouse

# --- RUNTIME -----------------------------------------------------------------
# API port (REQUIRED by the server entrypoint; conventionally 8080)
PORT=8080
# Vite base path (REQUIRED by vite.config.ts; "/" for root hosting)
BASE_PATH=/
# Node env / log level (OPTIONAL)
NODE_ENV=development
LOG_LEVEL=info
